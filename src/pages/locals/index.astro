---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Banner from "../../components/Banner.astro";
import CTA from "../../components/CTA.astro";
import { siteData } from "../../data/siteData";

const { locals } = siteData;
---

<BaseLayout
  title="Locals"
  description={`Meet our friends and trusted service providers in the valley`}
>
  <Header slot="header" />
  <Banner title="Local Directory" />
  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">
          Trusted Service Providers
        </h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          Friends and collaborators we've found in the valley,&nbsp;
        </p>
        <p>
          <a href="/contact" class="text-cyan-500">
            /contact us&nbsp;
          </a>
          to connect with the right team
        </p>
      </div>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {locals.map((local) => (
          <div class="flex gap-5 rounded-lg border border-border bg-background p-6 shadow-sm">
            <div>
              <h3 class="font-heading text-h3 font-semibold text-text">
                {local.title}
              </h3>
              <p class="mt-2 text-text-muted leading-relaxed">
                {local.description}
              </p>
              <p>
                {local.slug && (
                  <a href={`/locals/${local.slug}`} class="text-blue-600">
                    {local.title}
                  </a>
                )}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
